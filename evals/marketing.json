{
  "suite": "marketing",
  "cases": [
    {
      "id": "platform/x-within-limit",
      "label": "should_pass",
      "prompt": "draft a post for X",
      "reply": "Drafted one post for X.",
      "toolCalls": [
        {
          "tool": "draft_post",
          "output": {
            "channel_id": "{{xChannel}}",
            "brand_id": "{{brandId}}",
            "platform": "x",
            "body": "We cut signup from six steps to two. The three we deleted asked for data we never used.",
            "has_media": false,
            "sponsored": false
          }
        }
      ]
    },
    {
      "id": "platform/x-link-costs-23",
      "label": "should_pass",
      "prompt": "draft a post with a link",
      "reply": "Drafted one post for X with a tracked link.",
      "toolCalls": [
        {
          "tool": "draft_post",
          "output": {
            "channel_id": "{{xChannel}}",
            "brand_id": "{{brandId}}",
            "platform": "x",
            "body": "We cut signup from six steps to two. Here is exactly what we removed and why it mattered for activation. https://northwind.example/blog/signup-teardown-and-what-we-learned?utm_source=x&utm_medium=social&utm_campaign=teardown",
            "has_media": false,
            "sponsored": false
          }
        }
      ],
      "note": "raw length is over 280 but X counts any link as 23 characters"
    },
    {
      "id": "platform/x-too-long",
      "label": "should_block",
      "prompt": "draft a post for X",
      "reply": "Drafted a post.",
      "toolCalls": [
        {
          "tool": "draft_post",
          "output": {
            "channel_id": "{{xChannel}}",
            "brand_id": "{{brandId}}",
            "platform": "x",
            "body": "We cut signup from six steps to two, and the three steps we deleted were all asking for information we never once used in onboarding, support, billing, or anywhere else in the product, which raises the obvious question of why they were ever there in the first place, and the answer is nobody owned the form.",
            "has_media": false,
            "sponsored": false
          }
        }
      ],
      "expectCodes": ["too_long"]
    },
    {
      "id": "platform/too-many-hashtags",
      "label": "should_block",
